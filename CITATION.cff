    family-names: Peisach
    affiliation: Ariel University
version: 1.0.0
date-released: 2026-09-24
license: MIT
repository-code: "https://github.com/AdiPassover/skyline-aided-uav-navigation"
keywords:
  - UAV navigation
  - visual odometry
  - skyline
  - relocalization
  - GNSS-denied navigation
